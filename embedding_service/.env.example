# Embedding service configuration. Copy to .env and fill in.
# Required in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
EMBED_API_TOKEN=change-me
# "production" (default) refuses to start without a token; "dev" allows it (auth disabled).
EMBED_ENV=production
PORT=8000
MODEL_DIR=./models
# Quality thresholds
MIN_FACE_PX=80
BLUR_THRESHOLD=60
# Detector keeps faces scoring at least this; faces below ?min_score are flagged low_confidence.
DETECT_SCORE_FLOOR=0.6
# Limits
MAX_REQUEST_BYTES=5242880
MAX_IMAGE_SIDE=2000
MAX_IMAGE_PIXELS=40000000
MAX_BATCH_IMAGES=30
