# Matcher (recognition worker) configuration. Copy to .env and fill in.
# Camera: an index (0) or a stream URL (rtsp://user:pass@cam/stream, http://phone:8080/video) or a video file.
CAMERA_SOURCE=0
CAMERA_ID=door-1

# Embedding service (other server). Use HTTPS or a private network.
EMBED_URL=http://embedding-host:8000
EMBED_API_TOKEN=change-me

# Django dashboard
DJANGO_URL=http://dashboard-host:8001
DJANGO_API_TOKEN=change-me

# Matching
MATCH_THRESHOLD=0.363
MATCH_MARGIN=0.05
FPS=4
GALLERY_REFRESH_SECONDS=60
SESSION_POLL_SECONDS=10
MEMBER_COOLDOWN_SECONDS=300
IMPOSTER_COOLDOWN_SECONDS=20
FRAME_WIDTH=640

# Local state and status endpoint
OUTBOX_PATH=matcher_outbox.sqlite3
STATUS_PORT=8090
HTTP_TIMEOUT=10
