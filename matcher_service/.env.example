# Matcher (recognition worker) configuration. Copy to .env and fill in.
# Camera: an index (0) or a stream URL (rtsp://user:pass@cam/stream, http://phone:8080/video) or a video file.
CAMERA_SOURCE=0
CAMERA_ID=door-1

# Embedding service (other server). Use HTTPS or a private network.
EMBED_URL=http://embedding-host:8000
EMBED_API_TOKEN=change-me

# Django dashboard (gallery of registered faces + active sessions)
DJANGO_URL=http://dashboard-host:8001
DJANGO_API_TOKEN=change-me

# Attendance destination: "chain" writes straight to the Ethereum Attendance contract (default);
# "django" POSTs to the dashboard instead; "both" writes to the chain, then POSTs each record to Django
# with its tx_hash/block_number (imposters/banned go to Django only). Django always serves the gallery.
ATTENDANCE_SINK=both
# DJANGO_OUTBOX_PATH=matcher_outbox_django.sqlite3   # second outbox, only for "both"
CHAIN_RPC_URL=https://33wj9spz-8545.inc1.devtunnels.ms/
# Contract address (from "blockchain attendance/deployed.json"), or point CHAIN_DEPLOYED_FILE at that file.
CHAIN_CONTRACT_ADDRESS=0xeAe6327b50c44b3ea957C97DCA44283E75BB1F84
# CHAIN_DEPLOYED_FILE=../../blockchain attendance/deployed.json
# Private dev tunnel only: output of `devtunnel token <tunnel-id> --scopes connect` (or make port 8545 public).
CHAIN_TUNNEL_TOKEN=
# Leave both empty on Ganache (uses the node's first unlocked account = the deployer).
# CHAIN_PRIVATE_KEY signs locally (needed on a real network); it must be the contract owner's key.
CHAIN_PRIVATE_KEY=
CHAIN_FROM=
CHAIN_RECEIPT_TIMEOUT=60

# Matching
MATCH_THRESHOLD=0.363
MATCH_MARGIN=0.05
FPS=4
GALLERY_REFRESH_SECONDS=60
SESSION_POLL_SECONDS=10
MEMBER_COOLDOWN_SECONDS=300
IMPOSTER_COOLDOWN_SECONDS=20
FRAME_WIDTH=640

# Local state and status endpoint
OUTBOX_PATH=matcher_outbox.sqlite3
STATUS_PORT=8090
HTTP_TIMEOUT=10
